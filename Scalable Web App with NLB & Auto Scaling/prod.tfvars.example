# prod.tfvars.example
# Copy this file to prod.tfvars, fill in the required values, then run:
#   export CLOUDFLARE_API_TOKEN=...   # Zone / DNS / Edit on the zone; never put it in this file
#   terraform plan -var-file=prod.tfvars
#   terraform apply -var-file=prod.tfvars

project_name         = "scalable-webapp"
environment          = "prod"
region               = "us-east-1"

# Required — no defaults
key_pair_name        = "your-key-pair-name"
alarm_email          = "your@email.com"
domain_name          = "webapp-nlb.aterpise.com"            # hostname served over HTTPS
cloudflare_zone_id   = "<your-cloudflare-zone-id>"          # 32-character hex ID of the zone that holds domain_name

# Optional overrides
instance_type           = "t3.medium"
vpc_cidr                = "10.0.0.0/16"
public_subnet_cidrs     = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs    = ["10.0.3.0/24", "10.0.4.0/24"]
database_subnet_cidrs   = ["10.0.5.0/24", "10.0.6.0/24"]
asg_min_size            = 2
asg_max_size            = 6
asg_desired_capacity    = 2
cpu_scale_out_threshold = 70
cpu_scale_in_threshold  = 30
web_server              = "nginx"
ssl_policy              = "ELBSecurityPolicy-TLS13-1-2-Res-PQ-2025-09"

# Optional AMI override. Leave it out to use the latest Amazon Linux 2023
# x86_64 AMI. An override must be Amazon Linux 2023-compatible.
# ami_id                = "ami-XXXXXXXXXXXXXXXXX"

# Database (RDS for PostgreSQL 18, Multi-AZ DB instance). There is no password
# variable: RDS generates the master password and keeps it in Secrets Manager.
db_instance_class          = "db.t3.micro"
db_master_username         = "dbadmin"
db_backup_retention_period = 7
db_deletion_protection     = false   # a production stack would set this to true
db_skip_final_snapshot     = true    # a production stack would set this to false
