# Project-local safety net (root .gitignore also covers these).

# Terraform state (never commit — may contain secret material)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Local provider/plugin cache and module cache
**/.terraform/
.terraform.lock.hcl

# Real variable files (may contain secrets); .example files ARE committed
*.tfvars
!*.tfvars.example

# Plan artifacts
*.tfplan
*.plan
tfplan
tfplan.json

# Logs
*.log
crash.log
crash.*.log

# macOS
.DS_Store
