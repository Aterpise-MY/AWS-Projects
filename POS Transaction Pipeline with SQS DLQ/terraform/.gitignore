# Terraform local state — this stack uses a local backend. Never commit these.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
# .terraform.lock.hcl IS committed on purpose — it pins exact provider versions.

# Real variable values (may contain the on-call email address).
terraform.tfvars
*.auto.tfvars

# Lambda deployment packages generated by data "archive_file".
.build/
*.zip

# Plan artifacts.
*.tfplan
crash.log
