# Terraform state
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Terraform local directory
.terraform/
.terraform.lock.hcl

# Variable files (may contain secrets)
terraform.tfvars
*.tfvars
!*.tfvars.example

# Plan output files
*.tfplan
*.plan
tfplan
tfplan.json

# Logs
*.log
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# SSH private keys
*.pem

# macOS
.DS_Store

# Claude Code internal files (allow CLAUDE.md project instructions)
.claude/*
!.claude/CLAUDE.md

# ⚠️ SECURITY: Prevent secrets from being committed
# Variable files with hardcoded secrets
terraform.tfvars
terraform.tfvars.deploy
*.tfvars
!*.tfvars.example

# Environment files with credentials
.env
.env.local
.env.*.local
*.env

# AWS credentials
~/.aws/credentials
~/.aws/config

