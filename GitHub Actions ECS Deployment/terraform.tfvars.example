###############################################################################
# EXAMPLE VARIABLES — copy to terraform.tfvars and adjust.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is gitignored (contains account-specific choices).
###############################################################################

region       = "us-east-1"
project_name = "gha-ecs"
environment  = "prod"

# Networking
vpc_cidr = "10.30.0.0/16"
az_count = 2

# Container / task — container_name MUST match the GitHub Actions workflow
ecr_repository_name = "northwind-storefront"
container_name      = "my-container"
container_port      = 80
task_cpu            = 256
task_memory         = 512

# Service & scaling
desired_count    = 2
min_capacity     = 2
max_capacity     = 6
cpu_target_value = 50
health_check_path = "/"
log_retention_days = 14
