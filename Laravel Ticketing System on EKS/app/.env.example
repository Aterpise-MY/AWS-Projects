# =============================================================================
# Ticketing platform — example environment file
#
# PLACEHOLDER VALUES ONLY. Never commit real credentials.
# In the cluster, every value below is supplied by the Helm chart:
#   - non-secret values come from the ConfigMap rendered from values.yaml
#   - secret values come from the Kubernetes Secret materialised by
#     External Secrets Operator out of AWS Secrets Manager
#     (ticketing-dev/app-key, ticketing-dev/database, ticketing-dev/redis-auth,
#      ticketing-dev/smtp)
# This file exists for local development and as documentation of the contract.
# =============================================================================

APP_NAME="Ticketing"
APP_ENV=local
# Generate locally with: php artisan key:generate --show
APP_KEY=base64:REPLACE_ME_WITH_A_32_BYTE_BASE64_KEY
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

# Pods run behind an internet-facing ALB. bootstrap/app.php trusts all proxies
# because the ALB private IP is not knowable ahead of time; the ALB is the only
# thing that can reach the pod port, so X-Forwarded-* cannot be spoofed by clients.
TRUSTED_PROXIES=*

# -----------------------------------------------------------------------------
# Logging — stderr only. The container has a read-only root filesystem and Fluent
# Bit tails the container stdout/stderr stream into CloudWatch Logs.
# -----------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database — Amazon RDS for MySQL 8.0 (module `database`)
# Values injected from secret ticketing-dev/database
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=REPLACE_ME.ap-southeast-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=ticketing
DB_USERNAME=ticketing_admin
DB_PASSWORD=REPLACE_ME

# -----------------------------------------------------------------------------
# Redis — Amazon ElastiCache for Redis 7.1 (module `cache`)
# transit_encryption_enabled = true  -> REDIS_SCHEME=tls
# auth_token                          -> REDIS_PASSWORD (secret ticketing-dev/redis-auth)
#
# Logical DB index assignment (contract):
#   0 = cache   1 = sessions   2 = queue
# One ElastiCache node serves all three; separate indexes keep `cache:clear`
# from flushing sessions or draining the queue.
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_SCHEME=tls
REDIS_HOST=REPLACE_ME.cache.amazonaws.com
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=REPLACE_ME
REDIS_PREFIX=laravel_database_
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_QUEUE_DB=2

CACHE_STORE=redis
CACHE_PREFIX=ticketing_cache

# -----------------------------------------------------------------------------
# Sessions — redis (index 1). Never `file`: the root filesystem is read-only and
# pods are replaced on every deploy, so file sessions would log everyone out.
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Queue — redis (index 2). The `worker` Deployment consumes it; KEDA scales that
# Deployment on the list length of laravel_database_queues:default.
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
QUEUE_RETRY_AFTER=90

# -----------------------------------------------------------------------------
# Filesystem — attachments go to S3 (module `storage`).
# NO AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here on purpose: the pod assumes
# the `app` IRSA role and the AWS SDK default provider chain picks the web
# identity token up from AWS_ROLE_ARN + AWS_WEB_IDENTITY_TOKEN_FILE, which the
# EKS pod identity webhook injects automatically.
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=ticketing-dev-attachments-REPLACE_ME
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Mail — SMTP credentials from secret ticketing-dev/smtp
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=REPLACE_ME
MAIL_PORT=587
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=ticketing@example.com
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# SLA policy — hours from ticket creation to breach, per priority.
# EscalateSlaBreaches runs every 15 minutes and escalates anything past due.
# -----------------------------------------------------------------------------
SLA_HOURS_LOW=72
SLA_HOURS_NORMAL=24
SLA_HOURS_HIGH=8
SLA_HOURS_URGENT=2

VITE_APP_NAME="${APP_NAME}"
