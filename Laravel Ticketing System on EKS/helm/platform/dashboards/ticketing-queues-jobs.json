{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Ticketing - Queues and Jobs",
  "uid": "ticketing-queues-jobs",
  "tags": ["ticketing", "queue", "jobs"],
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Datasource"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Queue depth",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Redis queue depth per queue",
      "description": "The single most important number in a ticketing system: how many jobs are waiting. One series per queue key. Sustained growth means workers cannot keep up.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "redis_key_size{key=~\"laravel_database_queues:.*\"}",
          "legendFormat": "{{ key }}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Default queue backlog (now)",
      "description": "Alert TicketingQueueBacklogHigh fires when this stays above 100 for 5m.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "redis_key_size{key=\"laravel_database_queues:default\"}",
          "legendFormat": "default"
        }
      ]
    },
    {
      "type": "row",
      "title": "Failed jobs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Failed job count",
      "description": "Absolute size of the failed-job set. Source: redis exporter check-keys on laravel_database_queues:default:failed (requires the redis failed-job driver).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "redis_key_size{key=\"laravel_database_queues:default:failed\"}",
          "legendFormat": "failed jobs"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed job rate of change (15m increase)",
      "description": "Drives alert TicketingFailedJobsIncreasing. Any positive value means jobs are dying faster than they are cleared.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 40 },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "increase(redis_key_size{key=\"laravel_database_queues:default:failed\"}[15m])",
          "legendFormat": "15m increase"
        }
      ]
    }
  ]
}
