###############################################################################
# Storage — S3 bucket holding ticket attachments uploaded by end users.
#
# Access is granted exclusively through the `app` IRSA role created by the eks
# module (S3 Get/Put/Delete/List scoped to this bucket ARN). There is no bucket
# policy granting anyone else, and no public access of any kind.
###############################################################################

locals {
  tags        = merge(var.tags, { Component = "data" })
  bucket_name = "${var.name_prefix}-attachments-${var.bucket_suffix}"
}

resource "aws_s3_bucket" "attachments" {
  bucket = local.bucket_name

  # Dev environment: `terraform destroy` must not strand a bucket full of
  # versioned test uploads. Set to false for anything holding real data.
  force_destroy = var.force_destroy

  tags = merge(local.tags, { Name = local.bucket_name })
}

# Versioning protects against an application bug or a bad delete wiping an
# attachment. Combined with the lifecycle rule below, the recovery window is
# `noncurrent_version_expiration_days`.
resource "aws_s3_bucket_versioning" "attachments" {
  bucket = aws_s3_bucket.attachments.id

  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "attachments" {
  bucket = aws_s3_bucket.attachments.id

  rule {
    apply_server_side_encryption_by_default {
      # SSE-S3. Deliberately not a CMK: attachments are not regulated data here
      # and per-request KMS charges on a high-object-count bucket add up fast.
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_public_access_block" "attachments" {
  bucket = aws_s3_bucket.attachments.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# BucketOwnerEnforced disables ACLs entirely, so object ownership can never be
# split and only IAM policy decides access.
resource "aws_s3_bucket_ownership_controls" "attachments" {
  bucket = aws_s3_bucket.attachments.id

  rule {
    object_ownership = "BucketOwnerEnforced"
  }
}

resource "aws_s3_bucket_lifecycle_configuration" "attachments" {
  bucket = aws_s3_bucket.attachments.id

  rule {
    id     = "expire-noncurrent-versions"
    status = "Enabled"

    filter {}

    noncurrent_version_expiration {
      noncurrent_days = var.noncurrent_version_expiration_days
    }
  }

  rule {
    id     = "abort-incomplete-multipart-uploads"
    status = "Enabled"

    filter {}

    # Failed large uploads leave orphaned parts that are billed as storage but
    # are invisible in the object listing.
    abort_incomplete_multipart_upload {
      days_after_initiation = var.abort_incomplete_multipart_upload_days
    }
  }

  # S3 rejects a lifecycle configuration containing noncurrent-version rules
  # until versioning is actually enabled on the bucket.
  depends_on = [aws_s3_bucket_versioning.attachments]
}

# > Production note: attachments are served through pre-signed URLs generated by
# > the application, so no CORS rule or public read path is required. Add a CORS
# > configuration only if the browser ever uploads directly to S3.
