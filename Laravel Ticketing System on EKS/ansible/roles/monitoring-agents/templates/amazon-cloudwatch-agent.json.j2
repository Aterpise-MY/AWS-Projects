{
  "_comment": "Managed by Ansible (role: monitoring-agents). Manual edits are overwritten. HOST-level telemetry only: container logs go to CloudWatch via the Fluent Bit DaemonSet, and pod metrics via Container Insights. {{ monitoring_log_retention_note }}",
  "agent": {
    "metrics_collection_interval": {{ monitoring_metrics_interval_seconds }},
    "run_as_user": "root",
    "omit_hostname": true,
    "debug": false
  },
  "metrics": {
    "namespace": "{{ monitoring_cloudwatch_namespace }}",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}",
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}"
    },
    "aggregation_dimensions": [
      ["AutoScalingGroupName"],
      ["InstanceId"]
    ],
    "metrics_collected": {
      "mem": {
        "measurement": [
          {"name": "mem_used_percent", "unit": "Percent"},
          {"name": "mem_available_percent", "unit": "Percent"}
        ],
        "metrics_collection_interval": {{ monitoring_metrics_interval_seconds }}
      },
      "disk": {
        "measurement": [
          {"name": "used_percent", "unit": "Percent"},
          {"name": "inodes_free"}
        ],
        "resources": [
{% for mount in monitoring_collect_disk_mountpoints %}
          "{{ mount }}"{{ "," if not loop.last else "" }}
{% endfor %}
        ],
        "ignore_file_system_types": ["overlay", "tmpfs", "devtmpfs", "squashfs"],
        "metrics_collection_interval": {{ monitoring_metrics_interval_seconds }}
      },
      "diskio": {
        "measurement": ["io_time"],
        "resources": ["*"],
        "metrics_collection_interval": {{ monitoring_metrics_interval_seconds }}
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
{% for logfile in monitoring_host_log_files %}
          {
            "file_path": "{{ logfile.path }}",
            "log_group_name": "{{ monitoring_cloudwatch_log_group_prefix }}{{ logfile.path | regex_replace('^/var/log', '') }}",
            "log_stream_name": "{{ logfile.log_stream }}",
            "timezone": "UTC"
          }{{ "," if not loop.last else "" }}
{% endfor %}
        ]
      }
    }
  }
}
