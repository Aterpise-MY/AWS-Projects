{{ ansible_managed | comment }}
# Managed by Ansible (role: base-packages). Manual edits are overwritten.
#
# The Amazon Time Sync Service is reachable on a link-local address from inside
# the VPC with no egress. Clock drift on a Kubernetes node breaks certificate
# validation, IRSA token exchange and SigV4 signing before it breaks anything
# obvious, so this is not optional.

{% for server in base_packages_ntp_servers %}
server {{ server }} prefer iburst minpoll 4 maxpoll 4
{% endfor %}

driftfile /var/lib/chrony/drift
makestep 1.0 3
rtcsync
logdir /var/log/chrony

# Never act as a time server for anything else.
port 0
cmdport 0
