{{ ansible_managed | comment }}
# Managed by Ansible (role: containerd-tuning). Manual edits are overwritten.
#
# This is a DROP-IN. /etc/containerd/config.toml is generated by nodeadm at
# first boot and must not be edited — a hand-edited config.toml is how a node
# ends up never joining the cluster.
#
# SystemdCgroup is asserted rather than assumed: the EKS AL2023 AMI already sets
# it, and a node where the kubelet uses systemd cgroups while containerd uses
# cgroupfs has two accounting views of the same memory. The symptom is pods
# being OOM-killed well below their limit, which is a genuinely miserable thing
# to debug.

version = 2

[plugins."io.containerd.grpc.v1.cri"]
  # Raised from the default of 3. A cold Spot node pulling a large PHP image is
  # bound by this, not by bandwidth. Not raised further because every node in a
  # private subnet shares one NAT Gateway.
  max_concurrent_downloads = {{ containerd_max_concurrent_downloads }}

  # Fail a pull loudly rather than serving a half-fetched image.
  image_pull_progress_timeout = "5m"

[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc.options]
  SystemdCgroup = true

[plugins."io.containerd.grpc.v1.cri".registry]
  config_path = "/etc/containerd/certs.d"

# Prune the content store on the same schedule as the image cache so deleted
# layers actually release disk instead of lingering as unreferenced content.
[plugins."io.containerd.gc.v1.scheduler"]
  deletion_threshold = 0
  mutation_threshold = 100
  schedule_delay = "0s"
  startup_delay = "100ms"
