{{ ansible_managed | comment }}
# Managed by Ansible (role: cis-hardening). Manual edits are overwritten.
#
# CIS 5.2.x. Note the context: the node security group has NO port 22 ingress
# and no SSH key is ever provisioned. Operator access is SSM Session Manager
# only. sshd is hardened rather than removed because Packer connects over SSH to
# build the image, and a drop-in that disabled the transport being used to write
# it would be self-defeating.
#
# This file is validated with `sshd -t` before it is written, so a mistake here
# fails the play rather than locking the host.

PermitRootLogin {{ cis_sshd_settings.PermitRootLogin }}
PasswordAuthentication {{ cis_sshd_settings.PasswordAuthentication }}
PermitEmptyPasswords {{ cis_sshd_settings.PermitEmptyPasswords }}
KerberosAuthentication {{ cis_sshd_settings.KerberosAuthentication }}
GSSAPIAuthentication {{ cis_sshd_settings.GSSAPIAuthentication }}
X11Forwarding {{ cis_sshd_settings.X11Forwarding }}
AllowAgentForwarding {{ cis_sshd_settings.AllowAgentForwarding }}
AllowTcpForwarding {{ cis_sshd_settings.AllowTcpForwarding }}
PermitUserEnvironment {{ cis_sshd_settings.PermitUserEnvironment }}
IgnoreRhosts {{ cis_sshd_settings.IgnoreRhosts }}
HostbasedAuthentication {{ cis_sshd_settings.HostbasedAuthentication }}
MaxAuthTries {{ cis_sshd_settings.MaxAuthTries }}
MaxSessions {{ cis_sshd_settings.MaxSessions }}
LoginGraceTime {{ cis_sshd_settings.LoginGraceTime }}
ClientAliveInterval {{ cis_sshd_settings.ClientAliveInterval }}
ClientAliveCountMax {{ cis_sshd_settings.ClientAliveCountMax }}
LogLevel {{ cis_sshd_settings.LogLevel }}
Banner {{ cis_sshd_settings.Banner }}

# CIS 5.2.13/5.2.14 — modern ciphers, MACs and key exchange only.
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512
