{{ ansible_managed | comment }}
# Managed by Ansible (role: cis-hardening). Manual edits are overwritten.
#
# CIS 1.1.1.x — disable filesystem drivers no EC2 node will ever mount.
#
# NOT blacklisted here, and that is deliberate:
#   overlay       containerd's snapshotter; blacklisting it stops every pod
#   br_netfilter  required for kube-proxy iptables rules on bridged traffic
#   nf_conntrack  required by kube-proxy and the VPC CNI
#   squashfs      low value on EC2; some vendor DaemonSets ship squashfs images

{% for fs in cis_blacklist_filesystems %}
install {{ fs }} /bin/false
blacklist {{ fs }}
{% endfor %}
