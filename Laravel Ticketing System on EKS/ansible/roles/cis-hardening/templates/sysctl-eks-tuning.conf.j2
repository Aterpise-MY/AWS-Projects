{{ ansible_managed | comment }}
# Managed by Ansible (role: cis-hardening). Manual edits are overwritten.
#
# These are workload tuning parameters, NOT CIS controls. AL2023 ships
# general-purpose server defaults; a node running 30+ pods behind an ALB hits
# several of these ceilings long before it runs out of CPU or memory, and every
# one of them fails in a way that looks like an application bug.
#
# Loaded at 90- so the CIS security file at 95- wins any future collision.
#
# net.netfilter.* requires nf_conntrack, which is forced into
# /etc/modules-load.d/99-cis-conntrack.conf. Without that file these keys do not
# exist at boot and are silently dropped.

{% for key, value in cis_sysctl_tuning | dictsort %}
{{ key }} = {{ value }}
{% endfor %}
